{% extends 'base.html.twig' %}

{% block title %}Sign in - Recipe Archive{% endblock %}

{% block body %}
    <div class="flex min-h-[80vh] items-center justify-center px-4">
        <div class="w-full max-w-sm">
            <h1 class="text-2xl font-bold text-gray-900 mb-2 text-center">Welcome back</h1>
            <p class="text-sm text-gray-500 text-center mb-8">
                No account yet?
                <a href="{{ path('app_register') }}" class="text-indigo-600 hover:text-indigo-800">Create one</a>
            </p>

            {% if error %}
                <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3">
                    <p class="text-sm text-red-700">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-4 text-sm text-gray-700">
                    Signed in as {{ app.user.userIdentifier }}.
                    <a href="{{ path('app_logout') }}" class="text-indigo-600 hover:text-indigo-800">Sign out</a>
                </div>
            {% endif %}

            <form method="post" class="space-y-4">
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                           autocomplete="email" required autofocus placeholder="you@example.com">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" name="_password" id="password"
                           class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                           autocomplete="current-password" required>
                </div>

                <div class="flex justify-end">
                    <a href="{{ path('app_forgot_password_request') }}" class="text-sm text-gray-500 hover:text-gray-700">Forgot password?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full py-2.5 px-4 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                    Sign in
                </button>
            </form>
        </div>
    </div>
{% endblock %}
