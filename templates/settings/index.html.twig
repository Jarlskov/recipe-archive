{% extends 'base.html.twig' %}

{% block title %}Settings{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <h1 class="text-xl font-bold text-gray-900 mb-8">Settings</h1>

        <div class="bg-white rounded-xl border border-gray-100 divide-y divide-gray-100">
            <div class="px-4 py-4 flex justify-between items-center">
                <span class="text-sm text-gray-500">Email</span>
                <span class="text-sm text-gray-900">{{ app.user.email }}</span>
            </div>
            <div class="px-4 py-4 flex justify-between items-center">
                <span class="text-sm text-gray-500">Email verified</span>
                <div class="flex items-center space-x-3">
                    {% if app.user.isVerified %}
                        <span class="text-sm text-green-600">Yes</span>
                    {% else %}
                        <span class="text-sm text-yellow-600">Not yet</span>
                        <form action="{{ path('app_settings_resend_verification') }}" method="post" class="inline">
                            <button type="submit" class="text-sm text-indigo-600 hover:text-indigo-800 underline">
                                Resend email
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
