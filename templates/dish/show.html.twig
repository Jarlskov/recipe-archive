{% extends 'base.html.twig' %}

{% block title %}{{ dish.name }} - Recipe Archive{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_dashboard') }}" class="text-gray-400 hover:text-gray-500">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                    </a>
                    <h1 class="text-xl font-bold text-gray-900 truncate">{{ dish.name }}</h1>
                </div>
                <div>
                     <a href="{{ path('app_dish_edit', {'id': dish.id}) }}" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Edit Dish
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-medium text-gray-900">Recipes</h2>
            <a href="{{ path('app_recipe_new', {'dish_id': dish.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Add Recipe
            </a>
        </div>

        {% if dish.recipes|length > 0 %}
            <div class="space-y-4">
                {% for recipe in dish.recipes %}
                    <div class="bg-white shadow-sm rounded-lg border border-gray-100 p-5 hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start">
                            <div class="space-y-1">
                                <h3 class="text-lg font-bold text-gray-900">
                                    {% if recipe.reference starts with 'http' %}
                                        <a href="{{ recipe.reference }}" target="_blank" class="hover:text-indigo-600 hover:underline flex items-center gap-1">
                                            {{ recipe.title }}
                                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                        </a>
                                    {% else %}
                                        {{ recipe.title }}
                                    {% endif %}
                                </h3>
                                <p class="text-sm text-gray-500 mb-2">by <span class="font-medium text-gray-700">{{ recipe.author }}</span></p>
                                
                                <div class="flex items-center text-sm">
                                    {% if recipe.reference starts with 'http' %}
                                        <a href="{{ recipe.reference }}" target="_blank" class="flex items-center text-indigo-600 hover:text-indigo-800 transition-colors group/link">
                                            <svg class="mr-1.5 h-4 w-4 text-indigo-400 group-hover/link:text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                            <span class="underline decoration-indigo-200 group-hover/link:decoration-indigo-600">Visit Website</span>
                                        </a>
                                    {% else %}
                                        <div class="flex items-center text-gray-600">
                                            <svg class="mr-1.5 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                            </svg>
                                            {{ recipe.reference }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                             <div class="flex space-x-2">
                                <button class="text-gray-400 hover:text-indigo-600">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                </button>
                             </div>
                        </div>

                        <!-- Tags & Ingredients -->
                        <div class="mt-4 flex flex-wrap gap-2">
                            {% for tag in recipe.tags %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-50 text-indigo-700">
                                    #{{ tag.name }}
                                </span>
                            {% endfor %}
                            
                            {% if recipe.ingredients|length > 0 %}
                                <div class="w-full sm:w-auto h-px sm:h-auto bg-gray-100 sm:bg-transparent sm:border-l sm:border-gray-200 mx-1"></div>
                            {% endif %}

                            {% for ingredient in recipe.ingredients %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 border border-green-100">
                                    {{ ingredient.name }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-12 bg-white rounded-lg border border-dashed border-gray-300">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No recipes yet</h3>
                <p class="mt-1 text-sm text-gray-500">Add a recipe to this dish to get started.</p>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
