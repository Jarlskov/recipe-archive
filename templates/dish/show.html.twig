{% extends 'base.html.twig' %}

{% block title %}{{ dish.name }} - Recipe Archive{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumbs / Page Header -->
        <div class="mb-8">
            <nav class="flex mb-4" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li>
                        <a href="{{ path('app_dashboard') }}" class="text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors">Dashboard</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                            <span class="ml-2 text-sm font-bold text-gray-900">{{ dish.name }}</span>
                        </div>
                    </li>
                </ol>
            </nav>
            
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">{{ dish.name }}</h1>
                <div class="flex space-x-3">
                    <a href="{{ path('app_dish_edit', {'id': dish.id}) }}" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Edit Dish
                    </a>
                    <a href="{{ path('app_recipe_new', {'dish_id': dish.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Add Recipe
                    </a>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2 class="text-xl font-bold text-gray-900">Recipes in this dish</h2>

            {% if dish.recipes|length > 0 %}
                <div class="grid grid-cols-1 gap-6">
                    {% for recipe in dish.recipes %}
                        <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow relative">
                            <div class="flex justify-between items-start">
                                <div class="space-y-2">
                                    <h3 class="text-xl font-bold text-gray-900">
                                        {% if recipe.reference starts with 'http' %}
                                            <a href="{{ recipe.reference }}" target="_blank" class="hover:text-indigo-600 hover:underline flex items-center gap-2">
                                                {{ recipe.title }}
                                                <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                </svg>
                                            </a>
                                        {% else %}
                                            {{ recipe.title }}
                                        {% endif %}
                                    </h3>
                                    <p class="text-sm text-gray-500 italic">by <span class="font-medium text-gray-700">{{ recipe.author }}</span></p>
                                    
                                    <div class="flex items-center text-sm">
                                        {% if recipe.reference starts with 'http' %}
                                            <a href="{{ recipe.reference }}" target="_blank" class="flex items-center text-indigo-600 hover:text-indigo-800 transition-colors group/link">
                                                <svg class="mr-1.5 h-4 w-4 text-indigo-400 group-hover/link:text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                </svg>
                                                <span class="underline decoration-indigo-200 group-hover/link:decoration-indigo-600">Visit Website</span>
                                            </a>
                                        {% else %}
                                            <div class="flex items-center text-gray-600">
                                                <svg class="mr-1.5 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                                </svg>
                                                {{ recipe.reference }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <div class="flex space-x-2">
                                    <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-full transition-all">
                                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            <!-- Tags & Ingredients -->
                            <div class="mt-6 flex flex-wrap gap-2">
                                {% for tag in recipe.tags %}
                                    <a href="{{ path('app_dashboard', {'tags': tag.id}) }}" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-100 transition-colors">
                                        #{{ tag.name }}
                                    </a>
                                {% endfor %}
                                
                                {% if recipe.ingredients|length > 0 %}
                                    <div class="w-full sm:w-auto h-px sm:h-auto bg-gray-100 sm:bg-transparent sm:border-l sm:border-gray-200 mx-1"></div>
                                {% endif %}

                                {% for ingredient in recipe.ingredients %}
                                    <a href="{{ path('app_dashboard', {'ingredients': ingredient.id}) }}" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700 hover:bg-green-100 border border-green-100 transition-colors">
                                        {{ ingredient.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-16 bg-white rounded-xl border border-dashed border-gray-300">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No recipes yet</h3>
                    <p class="mt-1 text-sm text-gray-500">Add a recipe to this dish to get started.</p>
                    <div class="mt-6">
                        <a href="{{ path('app_recipe_new', {'dish_id': dish.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                            Add Recipe
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}