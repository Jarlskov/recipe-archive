{% extends 'base.html.twig' %}

{% block title %}{{ dish.name }} - Recipe Archive{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <a href="{{ path('app_dashboard') }}" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">&larr; Back</a>
            <div class="mt-4 flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-900">{{ dish.name }}</h1>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_recipe_new', {'dish_id': dish.id}) }}"
                       data-turbo-frame="modal-content"
                       data-action="click->modal#open"
                       class="px-4 py-2 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                        Add Recipe
                    </a>
                    <a href="{{ path('app_dish_edit', {'id': dish.id}) }}"
                       data-turbo-frame="modal-content"
                       data-action="click->modal#open"
                       class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Edit</a>
                </div>
            </div>
        </div>

        <!-- Recipes -->
        {% if dish.recipes|length > 0 %}
            <div class="space-y-3">
                {% for recipe in dish.recipes %}
                    <div class="bg-white rounded-xl border border-gray-100 px-4 py-4 hover:shadow-sm transition-shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-medium text-gray-900">
                                    {% if recipe.reference starts with 'http' %}
                                        <a href="{{ recipe.reference }}" target="_blank" class="hover:text-indigo-600 hover:underline">{{ recipe.title }}</a>
                                    {% else %}
                                        {{ recipe.title }}
                                    {% endif %}
                                </h3>
                                <p class="text-sm text-gray-500 mt-0.5">{{ recipe.author }}</p>
                                {% if not (recipe.reference starts with 'http') %}
                                    <p class="text-sm text-gray-400 mt-1">{{ recipe.reference }}</p>
                                {% endif %}
                            </div>
                            <div class="flex items-center space-x-3 ml-4 flex-shrink-0">
                                {% if recipe.reference starts with 'http' %}
                                    <a href="{{ recipe.reference }}" target="_blank" class="text-sm text-indigo-600 hover:underline">Open &rarr;</a>
                                {% endif %}
                                <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}"
                                   data-turbo-frame="modal-content"
                                   data-action="click->modal#open"
                                   class="text-gray-300 hover:text-gray-500 transition-colors" aria-label="Edit">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        {% if recipe.tags|length > 0 or recipe.ingredients|length > 0 %}
                            <div class="mt-3 flex flex-wrap gap-1.5">
                                {% for tag in recipe.tags %}
                                    <a href="{{ path('app_dashboard', {'tags': tag.id}) }}" class="px-2 py-0.5 rounded-full text-xs bg-purple-50 text-purple-700 hover:bg-purple-100 transition-colors">
                                        #{{ tag.name }}
                                    </a>
                                {% endfor %}
                                {% for ingredient in recipe.ingredients %}
                                    <a href="{{ path('app_dashboard', {'ingredients': ingredient.id}) }}" class="px-2 py-0.5 rounded-full text-xs bg-green-50 text-green-700 hover:bg-green-100 transition-colors">
                                        {{ ingredient.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-16 bg-white rounded-xl border border-dashed border-gray-200">
                <p class="text-gray-500 mb-1">No recipes yet.</p>
                <p class="text-sm text-gray-400">Add the first recipe to this dish.</p>
                <div class="mt-6">
                    <a href="{{ path('app_recipe_new', {'dish_id': dish.id}) }}"
                       data-turbo-frame="modal-content"
                       data-action="click->modal#open"
                       class="px-4 py-2 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                        Add Recipe
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
