{% extends 'base.html.twig' %}

{% block title %}Edit {{ dish.name }} - Recipe Archive{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">&larr; Back</a>

        <div class="mt-6 max-w-lg">
            <h1 class="text-xl font-bold text-gray-900 mb-6">Edit Dish</h1>

            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="px-5 py-2 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                        Save
                    </button>
                    <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="px-5 py-2 text-sm font-medium rounded-lg text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors">
                        Cancel
                    </a>
                </div>
            {{ form_end(form) }}

            <div class="mt-12 pt-8 border-t border-gray-100">
                <p class="text-sm font-medium text-gray-700 mb-3">Delete this dish</p>
                <p class="text-sm text-gray-500 mb-4">This will permanently remove the dish and all its recipes.</p>
                <form method="post" action="{{ path('app_dish_delete', {'id': dish.id}) }}" onsubmit="return confirm('Delete this dish and all its recipes? This cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dish.id) }}">
                    <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg text-red-600 border border-red-200 hover:bg-red-50 transition-colors">
                        Delete dish
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
