{% extends 'base.html.twig' %}

{% block title %}Edit {{ dish.name }} - Recipe Archive{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumbs -->
        <nav class="flex mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="{{ path('app_dashboard') }}" class="text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors">Dashboard</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                        <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="ml-2 text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors">{{ dish.name }}</a>
                    </div>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                        <span class="ml-2 text-sm font-bold text-gray-900">Edit</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="max-w-lg mx-auto bg-white shadow-xl rounded-2xl p-8 border border-gray-100">
            <h1 class="text-2xl font-extrabold text-gray-900 mb-6 text-center">Edit Dish</h1>
            
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name, {'attr': {'class': 'mt-2 text-sm text-red-600 font-medium'}}) }}
                </div>

                <div class="pt-6 flex flex-col sm:flex-row-reverse gap-3">
                    <button type="submit" class="w-full inline-flex justify-center py-2.5 px-4 border border-transparent shadow-sm text-sm font-bold rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                        Save Changes
                    </button>
                    <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="w-full inline-flex justify-center py-2.5 px-4 border border-gray-300 shadow-sm text-sm font-semibold rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                        Cancel
                    </a>
                </div>
            {{ form_end(form) }}

            <div class="mt-12 pt-10 border-t border-red-50">
                <h3 class="text-lg font-bold text-red-900 mb-4">Danger Zone</h3>
                <form method="post" action="{{ path('app_dish_delete', {'id': dish.id}) }}" onsubmit="return confirm('Are you sure you want to delete this dish and all its recipes? This action cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dish.id) }}">
                    <button type="submit" class="w-full inline-flex justify-center py-2.5 px-4 border border-transparent shadow-sm text-sm font-bold rounded-lg text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all">
                        Delete Dish
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}