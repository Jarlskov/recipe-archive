{% extends 'base.html.twig' %}

{% block title %}Internal Server Error - Recipe Archive{% endblock %}

{% block body %}
<div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <div class="space-y-6">
        <h1 class="text-9xl font-black text-red-50">500</h1>
        
        <div class="space-y-2">
            <h2 class="text-3xl font-bold text-gray-900 tracking-tight sm:text-4xl">Something went wrong</h2>
            <p class="text-lg text-gray-600 max-w-md mx-auto">
                Our server encountered an internal error. We've been notified and are looking into it. Please try again later.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
            <a href="{{ path('app_dashboard') }}" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-xl shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                Return to Dashboard
            </a>
            <button onclick="window.location.reload()" class="inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                Try Again
            </button>
        </div>
    </div>
</div>
{% endblock %}
