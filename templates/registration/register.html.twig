{% extends 'base.html.twig' %}

{% block title %}Create account - Recipe Archive{% endblock %}

{% block body %}
    <div class="flex min-h-[80vh] items-center justify-center px-4">
        <div class="w-full max-w-sm">
            <h1 class="text-2xl font-bold text-gray-900 mb-2 text-center">Create an account</h1>
            <p class="text-sm text-gray-500 text-center mb-8">
                Already have one?
                <a href="{{ path('app_login') }}" class="text-indigo-600 hover:text-indigo-800">Sign in</a>
            </p>

            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3">
                    <p class="text-sm text-red-700">{{ flash_error }}</p>
                </div>
            {% endfor %}

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.email, {
                        'attr': {'class': 'block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm', 'placeholder': 'you@example.com'}
                    }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {'class': 'block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm'}
                    }) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
                <div class="flex items-center gap-2">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-4 w-4 text-indigo-600 border-gray-300 rounded'}}) }}
                    {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
                </div>

                <button type="submit" class="w-full py-2.5 px-4 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                    Create account
                </button>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
