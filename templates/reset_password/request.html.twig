{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8 bg-white p-8 shadow-lg rounded-xl">
        <div class="text-center">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Reset your password</h1>
            <p class="mt-2 text-sm text-gray-600">
                Enter your email address and we will send you a
                link to reset your password.
            </p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="rounded-md bg-red-50 p-4 border border-red-200" role="alert">
                <p class="text-sm font-medium text-red-800">{{ flash_error }}</p>
            </div>
        {% endfor %}

        {{ form_start(requestForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}
            <div class="rounded-md shadow-sm">
                <div>
                    {{ form_label(requestForm.email, 'Email address', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(requestForm.email, {'attr': {'class': 'appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm', 'placeholder': 'name@example.com'}}) }}
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Send password reset email
                </button>
            </div>
        {{ form_end(requestForm) }}
        
        <div class="text-center mt-4">
            <a href="{{ path('app_login') }}" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
                Back to login
            </a>
        </div>
    </div>
</div>
{% endblock %}
