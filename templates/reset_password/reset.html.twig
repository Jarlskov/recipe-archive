{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8 bg-white p-8 shadow-lg rounded-xl">
        <div class="text-center">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Set new password</h1>
        </div>

        {{ form_start(resetForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}
            <div class="space-y-4">
                <div>
                    {{ form_row(resetForm.plainPassword.first, {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'},
                        'attr': {'class': 'appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm', 'placeholder': 'New password'}
                    }) }}
                </div>
                <div>
                    {{ form_row(resetForm.plainPassword.second, {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'},
                        'attr': {'class': 'appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm', 'placeholder': 'Repeat password'}
                    }) }}
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Reset password
                </button>
            </div>
        {{ form_end(resetForm) }}
    </div>
</div>
{% endblock %}
