<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Recipe Archive{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.svg') }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen" data-controller="modal" data-action="click->modal#clickOutside">
        <dialog data-modal-target="dialog" class="rounded-2xl shadow-2xl p-0 w-[calc(100%-2rem)] max-w-lg backdrop:bg-gray-900/50 backdrop:backdrop-blur-sm m-auto border-none overflow-hidden">
            <div class="bg-white max-h-[90vh] flex flex-col">
                <turbo-frame id="modal-content" class="overflow-y-auto p-0" data-action="turbo:submit-end->modal#submitEnd">
                    <!-- Content will be loaded here -->
                </turbo-frame>
            </div>
        </dialog>

        {% if app.user %}
            <!-- FAB -->
            <a href="{{ path('app_creation_choice') }}"
               data-turbo-frame="modal-content"
               data-action="click->modal#open"
               class="fixed bottom-8 right-8 z-[100] flex items-center justify-center w-16 h-16 bg-indigo-600 text-white rounded-full shadow-2xl hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:scale-110 active:scale-95"
               aria-label="Add new">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
            </a>

            <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
                <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between h-14 items-center">
                        <a href="{{ path('app_dashboard') }}" class="text-lg font-semibold text-gray-900 hover:text-indigo-600 transition-colors">
                            Recipe Archive
                        </a>
                        <div class="flex items-center space-x-4 text-sm">
                            <a href="{{ path('app_settings') }}" class="text-gray-500 hover:text-gray-900 transition-colors">Settings</a>
                            <a href="{{ path('app_logout') }}" class="text-gray-500 hover:text-gray-900 transition-colors">Sign out</a>
                        </div>
                    </div>
                </div>
            </nav>
        {% endif %}

        <main class="flex-grow">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
                        <div class="rounded-lg p-4 {{ label == 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' }}">
                            <p class="text-sm">{{ message }}</p>
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="py-8 mt-12">
            <p class="text-center text-gray-400 text-sm">
                &copy; {{ "now"|date("Y") }} Recipe Archive
            </p>
        </footer>
    </body>
</html>
