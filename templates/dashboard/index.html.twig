{% extends 'base.html.twig' %}

{% block title %}Dashboard - Recipe Archive{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex-shrink-0 flex items-center">
                    <span class="text-xl font-bold text-indigo-600 tracking-tight">Recipe Archive</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="hidden sm:block text-right">
                        <div class="text-sm font-medium text-gray-900">{{ app.user.userIdentifier }}</div>
                        <div class="text-xs text-gray-500">Member</div>
                    </div>
                    <a href="{{ path('app_logout') }}" class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Stats Row -->
        <div class="grid grid-cols-2 gap-4 sm:gap-6 mb-8">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total Dishes</p>
                <p class="text-3xl font-bold text-indigo-600 mt-1">{{ dishes|length }}</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total Recipes</p>
                <p class="text-3xl font-bold text-green-600 mt-1">{{ recipeCount }}</p>
            </div>
        </div>

        <!-- Dishes Grid Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
            <h2 class="text-2xl font-bold text-gray-900">Your Dishes</h2>
            <div class="flex space-x-3 w-full sm:w-auto">
                <a href="{{ path('app_recipe_new') }}" class="flex-1 sm:flex-none inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Add Recipe
                </a>
                <a href="{{ path('app_dish_new') }}" class="flex-1 sm:flex-none inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Add Dish
                </a>
            </div>
        </div>

        {% if dishes|length > 0 %}
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for dish in dishes %}
                    <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="block bg-white overflow-hidden shadow-sm rounded-xl border border-gray-100 hover:shadow-md hover:border-indigo-200 transition-all group">
                        <div class="p-6">
                            <h3 class="text-lg font-bold text-gray-900 mb-1 group-hover:text-indigo-600 transition-colors">{{ dish.name }}</h3>
                            <p class="text-sm text-gray-500 mb-4">
                                {{ dish.recipes|length }} {{ dish.recipes|length == 1 ? 'recipe' : 'recipes' }}
                            </p>
                            
                            <div class="pt-4 border-t border-gray-50 flex justify-between items-center">
                                <span class="text-xs text-gray-400 italic">Created {{ dish.createdAt|date('M d, Y') }}</span>
                                <span class="text-sm font-semibold text-indigo-600 group-hover:translate-x-1 transition-transform inline-flex items-center">
                                    View Recipes &rarr;
                                </span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            {% if standaloneRecipes|length == 0 %}
                <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No dishes or recipes</h3>
                    <p class="mt-1 text-sm text-gray-500">Get started by creating your first dish or recipe.</p>
                    <div class="mt-6 flex justify-center space-x-3">
                        <a href="{{ path('app_recipe_new') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                            Add Recipe
                        </a>
                        <a href="{{ path('app_dish_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                            Add Dish
                        </a>
                    </div>
                </div>
            {% endif %}
        {% endif %}

        {% if standaloneRecipes|length > 0 %}
            <div class="mt-12">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Unassigned Recipes</h2>
                <div class="space-y-4">
                    {% for recipe in standaloneRecipes %}
                        <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-5 flex justify-between items-center hover:shadow-md transition-shadow">
                            <div>
                                <h3 class="font-bold text-gray-900">{{ recipe.title }}</h3>
                                <p class="text-sm text-gray-500">{{ recipe.author }}</p>
                            </div>
                            <div class="flex items-center space-x-4">
                                <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="text-gray-400 hover:text-indigo-600 transition-colors">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                </a>
                                <span class="text-xs text-gray-400 italic hidden sm:block">Added {{ recipe.createdAt|date('M d, Y') }}</span>
                                
                                {% if recipe.reference starts with 'http' %}
                                    <a href="{{ recipe.reference }}" target="_blank" class="text-indigo-600 hover:text-indigo-500">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                {% else %}
                                    <span class="text-gray-400" title="{{ recipe.reference }}">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}