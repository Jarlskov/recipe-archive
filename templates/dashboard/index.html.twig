{% extends 'base.html.twig' %}

{% block title %}My Recipes{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Search & Filter -->
        <div class="mb-8">
            {{ form_start(searchForm, {'attr': {'class': 'space-y-3'}}) }}
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    {{ form_widget(searchForm.q) }}
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        {{ form_label(searchForm.tags, null, {'label_attr': {'class': 'block text-xs text-gray-500 mb-1'}}) }}
                        {{ form_widget(searchForm.tags) }}
                    </div>
                    <div>
                        {{ form_label(searchForm.ingredients, null, {'label_attr': {'class': 'block text-xs text-gray-500 mb-1'}}) }}
                        {{ form_widget(searchForm.ingredients) }}
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    {% if searchQuery or activeTags|length > 0 or activeIngredients|length > 0 %}
                        <a href="{{ path('app_dashboard') }}" class="text-sm text-gray-500 hover:text-gray-700">Clear filters</a>
                    {% else %}
                        <span></span>
                    {% endif %}
                    <button type="submit" class="px-4 py-1.5 text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
                        Search
                    </button>
                </div>
            {{ form_end(searchForm) }}
        </div>

        <!-- Dishes -->
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Your Dishes</h2>

        {% if dishes|length > 0 %}
            <div class="space-y-2 mb-10">
                {% for dish in dishes %}
                    <a href="{{ path('app_dish_show', {'id': dish.id}) }}" class="flex justify-between items-center bg-white px-4 py-3 rounded-xl border border-gray-100 hover:border-indigo-200 hover:shadow-sm transition-all group">
                        <span class="font-medium text-gray-900 group-hover:text-indigo-600 transition-colors">{{ dish.name }}</span>
                        <span class="text-sm text-gray-400">{{ dish.recipes|length }} {{ dish.recipes|length == 1 ? 'recipe' : 'recipes' }} &rarr;</span>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            {% if searchQuery or activeTags|length > 0 or activeIngredients|length > 0 %}
                <div class="text-center py-10 mb-10">
                    <p class="text-gray-500">No dishes found.</p>
                    <a href="{{ path('app_dashboard') }}" class="mt-2 inline-block text-sm text-indigo-600 hover:text-indigo-800">Clear filters</a>
                </div>
            {% elseif standaloneRecipes|length == 0 %}
                <div class="text-center py-16 bg-white rounded-xl border border-dashed border-gray-200 mb-10">
                    <p class="text-gray-500 mb-1">Nothing here yet.</p>
                    <p class="text-sm text-gray-400">Tap the + button to add your first recipe.</p>
                </div>
            {% endif %}
        {% endif %}

        {% if standaloneRecipes|length > 0 %}
            <div id="unassigned-recipes">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Other Recipes</h2>
                <div class="space-y-2">
                    {% for recipe in standaloneRecipes %}
                        <div class="bg-white rounded-xl border border-gray-100 px-4 py-3 hover:shadow-sm transition-shadow">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-medium text-gray-900">{{ recipe.title }}</h3>
                                    <p class="text-sm text-gray-500">{{ recipe.author }}</p>
                                </div>
                                <div class="flex items-center space-x-3 ml-4 flex-shrink-0">
                                    {% if recipe.reference starts with 'http' %}
                                        <a href="{{ recipe.reference }}" target="_blank" class="text-sm text-indigo-600 hover:underline">Open &rarr;</a>
                                    {% else %}
                                        <span class="text-sm text-gray-400">{{ recipe.reference }}</span>
                                    {% endif %}
                                    <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="text-gray-300 hover:text-gray-500 transition-colors" aria-label="Edit">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            {% if recipe.tags|length > 0 or recipe.ingredients|length > 0 %}
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    {% for tag in recipe.tags %}
                                        <a href="{{ path('app_dashboard', {'tags': tag.id}) }}" class="px-2 py-0.5 rounded-full text-xs bg-purple-50 text-purple-700 hover:bg-purple-100 transition-colors">
                                            #{{ tag.name }}
                                        </a>
                                    {% endfor %}
                                    {% for ingredient in recipe.ingredients %}
                                        <a href="{{ path('app_dashboard', {'ingredients': ingredient.id}) }}" class="px-2 py-0.5 rounded-full text-xs bg-green-50 text-green-700 hover:bg-green-100 transition-colors">
                                            {{ ingredient.name }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
