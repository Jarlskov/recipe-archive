{% extends 'base.html.twig' %}

{% block title %}Edit {{ recipe.title }} - Recipe Archive{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <a href="{{ recipe.dish ? path('app_dish_show', {'id': recipe.dish.id}) : path('app_dashboard') }}" class="text-gray-400 hover:text-gray-500">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                    </a>
                    <h1 class="text-xl font-bold text-gray-900 truncate">Edit Recipe</h1>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto bg-white shadow rounded-xl p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Recipe Details</h2>
            
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.author, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.author) }}
                        {{ form_errors(form.author, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.dish, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.dish) }}
                        {{ form_errors(form.dish, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.reference, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.reference) }}
                    {{ form_errors(form.reference, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.tags, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.tags) }}
                    </div>
                    <div>
                        {{ form_label(form.ingredients, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.ingredients) }}
                    </div>
                </div>

                <div class="pt-6 flex flex-col sm:flex-row-reverse gap-3">
                    <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Save Changes
                    </button>
                    <a href="{{ recipe.dish ? path('app_dish_show', {'id': recipe.dish.id}) : path('app_dashboard') }}" class="w-full inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                        Cancel
                    </a>
                </div>
            {{ form_end(form) }}

            <div class="mt-10 pt-10 border-t border-gray-100">
                <h3 class="text-lg font-medium text-gray-900 mb-4">Danger Zone</h3>
                <form method="post" action="{{ path('app_recipe_delete', {'id': recipe.id}) }}" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                    <button type="submit" class="w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
                        Delete Recipe
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>
{% endblock %}
